{
  "version": 2,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/signup",
      "destination": "/api/auth?action=signup"
    },
    {
      "source": "/api/resend-verification",
      "destination": "/api/auth?action=resend-verification"
    },
    {
      "source": "/api/verify-email",
      "destination": "/api/auth?action=verify-email"
    },
    {
      "source": "/api/totp-setup",
      "destination": "/api/auth?action=totp-setup"
    },
    {
      "source": "/api/totp-confirm",
      "destination": "/api/auth?action=totp-confirm"
    },
    {
      "source": "/api/channels",
      "destination": "/api/telegram?action=channels"
    },
    {
      "source": "/api/telegram-observation",
      "destination": "/api/telegram?action=telegram-observation"
    },
    {
      "source": "/api/telegram-inbox",
      "destination": "/api/telegram?action=telegram-inbox"
    },
    {
      "source": "/api/forgot-password",
      "destination": "/api/auth?action=forgot-password"
    },
    {
      "source": "/api/reset-password",
      "destination": "/api/auth?action=reset-password"
    },
    {
      "source": "/api/telegram-listener-requests",
      "destination": "/api/telegram?action=telegram-listener-requests"
    },
    {
      "source": "/api/channel-challenge",
      "destination": "/api/telegram?action=channel-challenge"
    },
    {
      "source": "/api/channel-toggle",
      "destination": "/api/telegram?action=channel-toggle"
    },
    {
      "source": "/api/telegram-bot-webhook",
      "destination": "/api/telegram?action=bot-webhook"
    },
    {
      "source": "/api/mt5-pair",
      "destination": "/api/brokers"
    }
  ]
}
